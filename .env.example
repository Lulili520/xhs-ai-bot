# AI 服务：deepseek 或 openai
AI_PROVIDER=deepseek

# DeepSeek（默认）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI（AI_PROVIDER=openai 时使用）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
AI_MAX_HISTORY=8
AI_MAX_REPLY_CHARS=300
KNOWLEDGE_BASE_PATH=data/knowledge/knowledge-base.json

HEADLESS=false
SCAN_INTERVAL_MS=500
REPLY_DELAY_MS=1000
LOG_FILE=data/logs/service.log

GOLD_PRICE_ENABLED=true
GOLD_PRICE_URL=https://h5.baobte.com/679/quote
GOLD_PRODUCT_NAME=黄金
GOLD_POLL_INTERVAL_MS=3000
GOLD_STALE_AFTER_MS=30000

# 回复中提到“微信”或“名片”时，自动发送获客工具里的微信名片
WECHAT_CARD_ENABLED=true
WECHAT_CARD_ON_WECHAT_MENTION=true
# enterprise=企业微信，personal=个人微信
WECHAT_CARD_TYPE=enterprise
# 只有一张对应类型的卡片时可留空；存在多张时必须填写完整标题
WECHAT_CARD_NAME=
